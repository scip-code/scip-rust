{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Warsaw",
  "schedule": ["before 9am on monday"],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-3 * * 1"],
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yaml$/"],
      "matchStrings": [
        "(?:repo|repository): (?<depName>[^\\s${]+)\\s+ref: (?<currentValue>[^\\s${]+)"
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "description": "NixOS release upgrades, such as nixos-26.05 to nixos-26.11, need a manual merge however Renovate classifies them.",
      "matchManagers": ["nix"],
      "matchDepNames": ["nixpkgs"],
      "matchUpdateTypes": ["major", "minor"],
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".github/workflows/ci.yaml"],
      "groupName": "CI test projects",
      "schedule": ["* * 1 */3 *"],
      "automerge": true
    }
  ]
}
